# =============================================================================
# PRODUCTION CHECKLIST — READ BEFORE DEPLOYING
#
# The values in this file are tuned for LOCAL development, because `composer
# setup` copies it to .env and runs the migrations. Do NOT ship it as-is: the
# server's own .env must override every line below.
#
#   APP_ENV=production
#   APP_DEBUG=false            <- critical. Left true, any error page shows
#                                 stack traces, file paths and the database
#                                 username and password to whoever hit it.
#   APP_URL=https://your-domain.gov.ph
#   SESSION_SECURE_COOKIE=true <- see the session block below
#   LOG_LEVEL=error            <- debug writes request detail to disk
#
# After changing them run: php artisan config:cache
# =============================================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shows the nginx error log in Settings -> Server Logs, where 502/504 and 413
# live — nginx rejects those before PHP runs, so laravel.log never sees them.
# Leave unset locally: `php artisan serve` is the dev server, there is no nginx.
# On the server the file must be readable by the web user; grant that on this
# one file rather than adding www-data to `adm`, which also exposes auth.log.
# NGINX_ERROR_LOG=/var/log/nginx/liquid-error.log

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sends the login cookie over HTTPS only. MUST be true in production —
# without it the cookie can cross the network in clear text and be captured
# on shared Wi-Fi, letting someone reuse the session. Left unset here so
# local development over http://127.0.0.1 keeps working.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Temporary print/Excel/CSV files. Use "s3" only when the web and queue
# processes do not share the same local filesystem and S3 is fully configured.
REPORT_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional path prefix transparently applied to every S3 operation.
# Local development: set to "dev" to isolate test uploads from production data.
# Production: leave empty.
AWS_PATH_PREFIX=

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# OpenAI — used by the Report Assistant via the laravel/ai SDK.
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY and OPENAI_URL are read by laravel/ai's openai provider.
# OPENAI_REPORT_ASSISTANT_MODEL overrides the model for this app's Report
# Assistant only (swap to gpt-5-mini / gpt-5 for higher quality at higher cost).
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_REPORT_ASSISTANT_MODEL=gpt-5-nano
OPENAI_TIMEOUT=45

# MCP server (exposes liquidation reporting tools to external AI clients)
# Generate MCP_API_KEY with: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
# MCP_USER_EMAIL must reference an active Admin or Super Admin with view_reports permission.
MCP_API_KEY=
MCP_USER_EMAIL=

VITE_APP_NAME="${APP_NAME}"
